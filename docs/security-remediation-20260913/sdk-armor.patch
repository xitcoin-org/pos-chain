@@ -0,0 +1,62 @@
+package crypto_test
+
+import (
+	"bytes"
+	"io"
+	"testing"
+
+	sdkcrypto "github.com/cosmos/cosmos-sdk/crypto"
+	"github.com/cosmos/cosmos-sdk/crypto/keys/secp256k1"
+	"github.com/stretchr/testify/require"
+	oldarmor "golang.org/x/crypto/openpgp/armor"
+)
+
+// Only a test oracle; never used by production. All keys are synthetic.
+func oldEncode(t *testing.T, kind string, headers map[string]string, payload []byte) string {
+	t.Helper()
+	var buf bytes.Buffer
+	w, err := oldarmor.Encode(&buf, kind, headers)
+	require.NoError(t, err)
+	_, err = w.Write(payload)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	return buf.String()
+}
+
+func TestHistoricalArmorCompatibility(t *testing.T) {
+	key := secp256k1.GenPrivKey()
+	for _, version := range []string{"0.0.0", "0.0.1"} {
+		t.Run("public-"+version, func(t *testing.T) {
+			encoded := oldEncode(t, "TENDERMINT PUBLIC KEY", map[string]string{"version": version}, key.PubKey().Bytes())
+			got, algo, err := sdkcrypto.UnarmorPubKeyBytes(encoded)
+			require.NoError(t, err)
+			require.Equal(t, "secp256k1", algo)
+			require.Equal(t, key.PubKey().Bytes(), got)
+		})
+	}
+	t.Run("info", func(t *testing.T) {
+		payload := []byte("synthetic historical info")
+		encoded := oldEncode(t, "TENDERMINT KEY INFO", map[string]string{"version": "0.0.0", "type": "Info"}, payload)
+		got, err := sdkcrypto.UnarmorInfoBytes(encoded)
+		require.NoError(t, err)
+		require.Equal(t, payload, got)
+	})
+	t.Run("argon2-chacha-old-reader-and-writer", func(t *testing.T) {
+		encoded := sdkcrypto.EncryptArmorPrivKey(key, "synthetic-passphrase", "")
+		old, err := oldarmor.Decode(bytes.NewBufferString(encoded))
+		require.NoError(t, err)
+		payload, err := io.ReadAll(old.Body)
+		require.NoError(t, err)
+		historical := oldEncode(t, old.Type, old.Header, payload)
+		got, algo, err := sdkcrypto.UnarmorDecryptPrivKey(historical, "synthetic-passphrase")
+		require.NoError(t, err)
+		require.Equal(t, "secp256k1", algo)
+		require.True(t, key.Equals(got))
+		_, _, err = sdkcrypto.UnarmorDecryptPrivKey(historical, "incorrect")
+		require.Error(t, err)
+	})
+	for _, bad := range []string{"", "not armor", "-----BEGIN TENDERMINT PRIVATE KEY-----\n\ninvalid!\n-----END TENDERMINT PRIVATE KEY-----"} {
+		_, _, _, err := sdkcrypto.DecodeArmor(bad)
+		require.Error(t, err)
+	}
+}
