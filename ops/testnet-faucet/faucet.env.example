# Copy to /etc/xitcoin-testnet/faucet.env and adapt deployment paths.
HOST=127.0.0.1
PORT=18089
CHAIN_ID=xitcoin-testnet-v2-1
RPC_NODE=tcp://sentry.example.invalid:31657
API_URL=https://api-testnet.xitcoin.org
BIN=/usr/local/bin/xitcoind
FAUCET_HOME=/var/lib/xitcoin-faucet
KEYRING_DIR=/var/lib/xitcoin-faucet/keyring
KEY_NAME=faucet-official
AMOUNT_BASE=10000000000000000000
RESERVE_BASE=10000000000000000000
IP_LIMIT=3
IP_WINDOW_SECONDS=86400
ADDRESS_WINDOW_SECONDS=86400
